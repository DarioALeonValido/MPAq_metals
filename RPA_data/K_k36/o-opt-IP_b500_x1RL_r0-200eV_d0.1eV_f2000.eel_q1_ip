# |  0.000000 | 0.000000 | 0.000000 |        # [CUT] [au] Box sides
# | %
# | CUTRadius= 0.000000              # [CUT] [au] Sphere/Cylinder radius
# | CUTCylLen= 0.000000              # [CUT] [au] Cylinder length
# | CUTwsGvec= 0.000000              # [CUT] WS cutoff: number of G to be modified
# | Chimod= "IP"                     # [X] IP/Hartree/ALDA/LRC/PF/BSfxc
# | DipComputed= "R V P"             # [DIP] [default R P V; extra P2 Spin Orb]
# | % QpntsRXd
# |   1 | 20 |                           # [Xd] Transferred momenta
# | %
# | % BndsRnXd
# |     1 |  500 |                       # [Xd] Polarization function bands
# | %
# | GrFnTpXd= "R"                    # [Xd] Green`s function (T)ordered,(R)etarded,(r)senant,(a)ntiresonant [T, R, r, Ta, Ra]
# | % EnRngeXd
# |    0.0000 | 200.0000 |         eV    # [Xd] Energy range
# | %
# | % DmRngeXd
# |  0.100000 | 0.100000 |         eV    # [Xd] Damping range
# | %
# | ETStpsXd= 2000                   # [Xd] Total Energy steps
# | % LongDrXd
